# Generate an RSA signing pair. Never commit production keys.
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out jwt-private.pem
# openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# openssl pkcs8 -topk8 -inform PEM -outform DER -in jwt-private.pem -nocrypt | base64 -w0
# openssl pkey -pubin -in jwt-public.pem -outform DER | base64 -w0
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_KEY_ID=sherlock-auth-rs256-1
# openssl rand -base64 32
MFA_ENCRYPTION_KEY_BASE64=
DATABASE_PASSWORD=
SERVICE_INTERNAL_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443,https://sherlock-in.vercel.app
# Set to true to create the demo accounts (never in production)
SEED_DEMO_DATA=false
PASSWORD_RESET_URL=http://localhost:5173/reset-password
MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@sherlock.in
TEAM_INVITE_URL=https://sherlock-in.vercel.app/invite
